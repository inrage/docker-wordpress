#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >> /tmp/wp-calls

case "$*" in
  "core version")
    printf '6.8\n'
    ;;
  "eval echo WP_CONTENT_DIR;")
    if [ "${TEST_ROCKET_CONFIG_FAIL:-false}" = bootstrap ]; then
      printf 'Error: Could not generate WP Rocket configuration.\n' >&2
      exit 1
    fi
    if [ "${TEST_WP_UNINSTALLED:-false}" = true ]; then
      printf 'Error: WordPress is not installed.\n' >&2
      exit 1
    fi
    printf '/var/www/html/wp-content\n'
    ;;
  "eval ")
    if [ "${TEST_ROCKET_CONFIG_FAIL:-false}" = true ]; then
      printf 'Error: Could not generate WP Rocket configuration.\n' >&2
      exit 42
    fi
    ;;
  "cli has-command redis enable")
    test -n "${TEST_REDIS_PLUGIN:-}" && test "$TEST_REDIS_PLUGIN" != absent
    ;;
  "redis")
    test "${TEST_REDIS_PLUGIN:-}" != absent
    ;;
  "acorn"|"acorn optimize"|"acorn icons"|"acorn icons:cache"|"cache")
    ;;
  "redis enable --force")
    printf 'replaced-drop-in\n' > /var/www/html/wp-content/object-cache.php
    rm -f /tmp/cache-sentinel /tmp/transient-sentinel
    ;;
  "cache flush")
    rm -f /tmp/cache-sentinel
    ;;
  "eval "*)
    if [[ "$2" != *RedisCachePro* ]]; then
      exit 91
    fi
    php -r '
      define("WP_CONTENT_DIR", "/var/www/html/wp-content");
      if ($argv[2] === "pro") {
          define("RedisCachePro\\Filename", "/tests/redis/pro/plugin.php");
      } elseif ($argv[2] === "community") {
          define("WP_REDIS_PLUGIN_PATH", "/tests/redis/community");
      }
      class WP_CLI {
          public static function error($message) {
              fwrite(STDERR, $message . PHP_EOL);
              exit(1);
          }
      }
      eval($argv[1]);
    ' "$2" "${TEST_REDIS_PLUGIN:-unknown}"
    ;;
  *)
    printf 'Unexpected wp invocation: %s\n' "$*" >&2
    exit 91
    ;;
esac
