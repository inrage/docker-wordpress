{
	{$CADDY_GLOBAL_OPTIONS}

	auto_https off

	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:4}
		{$FRANKENPHP_CONFIG:}
	}

	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}

	order cache before rewrite

	{$CADDY_CACHE_GLOBAL:}
}

{$SERVER_NAME} {
	root * {$SERVER_ROOT:/var/www/html/public}

	encode zstd br gzip

	@bypass header_regexp Cookie "({$INR_CACHE_BYPASS_COOKIES:wordpress_logged_in_})"

	handle @bypass {
		php_server
	}

	handle {
		{$INR_CACHE_DIRECTIVE:}
		php_server
	}
}
